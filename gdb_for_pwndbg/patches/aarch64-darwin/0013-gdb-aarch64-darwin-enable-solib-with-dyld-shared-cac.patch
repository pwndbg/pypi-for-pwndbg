From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Can Acar <canacar@imcan.dev>
Date: Wed, 29 Oct 2025 13:02:26 -0700
Subject: [PATCH 13/14] gdb/aarch64-darwin: enable solib with dyld shared cache
 logic

Accomplished by writing a glue tdep.
---
 gdb/Makefile.in           |  2 ++
 gdb/aarch64-darwin-tdep.c | 57 +++++++++++++++++++++++++++++++++++++++
 gdb/configure.tgt         |  5 ++++
 3 files changed, 64 insertions(+)
 create mode 100644 gdb/aarch64-darwin-tdep.c

diff --git a/gdb/Makefile.in b/gdb/Makefile.in
index df006cc..f316a02 100644
--- a/gdb/Makefile.in
+++ b/gdb/Makefile.in
@@ -721,6 +721,7 @@ ALL_AMD_DBGAPI_TARGET_OBS = \
 # (used with --enable-targets=all --enable-64-bit-bfd).
 ALL_64_TARGET_OBS = \
 	aarch64-fbsd-tdep.o \
+	aarch64-darwin-tdep.o \
 	aarch64-linux-tdep.o \
 	aarch64-newlib-tdep.o \
 	aarch64-ravenscar-thread.o \
@@ -1777,6 +1778,7 @@ ALLDEPFILES = \
 	arch/tic6x.c \
 	aarch32-tdep.c \
 	aarch64-darwin-nat.c \
+	aarch64-darwin-tdep.c \
 	aarch64-fbsd-nat.c \
 	aarch64-fbsd-tdep.c \
 	aarch64-linux-nat.c \
diff --git a/gdb/aarch64-darwin-tdep.c b/gdb/aarch64-darwin-tdep.c
new file mode 100644
index 0000000..02dc447
--- /dev/null
+++ b/gdb/aarch64-darwin-tdep.c
@@ -0,0 +1,57 @@
+/* Darwin support for GDB, the GNU debugger.
+   Copyright (C) 1997-2025 Free Software Foundation, Inc.
+
+   Contributed by Can Acar.
+   Based on i386-darwin-tdep.c
+
+   This file is part of GDB.
+
+   This program is free software; you can redistribute it and/or modify
+   it under the terms of the GNU General Public License as published by
+   the Free Software Foundation; either version 3 of the License, or
+   (at your option) any later version.
+
+   This program is distributed in the hope that it will be useful,
+   but WITHOUT ANY WARRANTY; without even the implied warranty of
+   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+   GNU General Public License for more details.
