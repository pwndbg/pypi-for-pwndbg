+
+/// True if \a symbol is an ELF thread-local (STT_TLS) symbol.
+///
+/// ObjectFileELF lowers STT_TLS to eSymbolTypeData, so the symbol type alone
+/// cannot tell thread-local data apart from ordinary data. It does keep the
+/// ELF st_info in the symbol flags (packed as `st_other << 8 | st_info`), so
+/// the ELF symbol type survives in the low four bits.
+static bool IsELFThreadLocalSymbol(const Symbol &symbol) {
+  const uint32_t elf_st_type_mask = 0xf;
+  const uint32_t elf_stt_tls = 6; // STT_TLS
+
+  ModuleSP module_sp = symbol.GetAddress().GetModule();
+  if (!module_sp)
+    return false;
+
+  // Symbol flags only hold st_info for ELF; other object file formats use
+  // them differently, so do not read TLS-ness out of them there.
+  if (!module_sp->GetArchitecture().GetTriple().isOSBinFormatELF())
+    return false;
+
+  return (symbol.GetFlags() & elf_st_type_mask) == elf_stt_tls;
+}
+
+addr_t Thread::GetThreadLocalSymbolAddress(const Symbol &symbol) {
+  if (!IsELFThreadLocalSymbol(symbol))
+    return LLDB_INVALID_ADDRESS;
+
+  const Address symbol_address = symbol.GetAddress();
+  ModuleSP module_sp = symbol_address.GetModule();
+  if (!module_sp)
+    return LLDB_INVALID_ADDRESS;
+
+  // GetThreadLocalData() takes the same value DW_OP_form_tls_address would
+  // push and normalizes it against PT_TLS itself, so hand it the file address
+  // and let it add the per-thread block.
+  return GetThreadLocalData(module_sp, symbol_address.GetFileAddress());
 }
 
