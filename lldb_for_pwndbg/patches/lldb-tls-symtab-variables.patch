+bool ObjectFileELF::IsThreadLocalSymbol(const Symbol &symbol) const {
+  // ParseSymtab() packs `st_other << 8 | st_info` into the symbol flags, so
+  // the low four bits hold the ELF symbol type, as ELFSymbol::getType() does.
+  return (symbol.GetFlags() & 0x0f) == STT_TLS;
+}
